<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 차량 정보 (VIN / GEAR / IGNITION_STATE) -->
    <uses-permission android:name="android.car.permission.CAR_INFO"/>
    <uses-permission android:name="pleos.car.permission.CAR_INFO"/>
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN"/>

    <!-- 네트워크 (MQTT 브로커 / 백엔드 REST API) -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- 위치 (동적 지오펜스 — GeofenceManager) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- 백그라운드 위치: 시동 OFF 상태에서도 지오펜스 유지 -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <!-- Foreground Service (백그라운드 주차 감시) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <!-- 알림 (입차 확정 / 결제 완료 Notification — Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <application
        android:label="Car PayIn"
        android:theme="@style/Theme.AppCompat"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: Mock 백엔드 http 연결 허용 (실서버 https 전환 시 제거) -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN