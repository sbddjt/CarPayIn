<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080C10"
    android:padding="20dp">

    <RelativeLayout
        android:id="@+id/tvHeaderTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Car PayIn"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>

        <Button
            android:id="@+id/btnResetApp"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#1A2535"
            android:text="등록 해제"
            android:textColor="#FF6B6B"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layoutUnregistered"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="등록된 결제 수단이 없습니다"
            android:textColor="#888888"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="#00E87A"
            android:text="결제 카드 등록하기"
            android:textColor="#000000"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/layoutRegistered"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/tvStatusDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="#00FF88"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:id="@+id/tvPaymentStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="주차장 접근 시 자동 결제됩니다"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"/>
                <TextView
                    android:id="@+id/tvParkingBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="미주차"
                    android:textColor="#556677"
                    android:background="#111820"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mainCardBody"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#1A1A2E"
                android:elevation="8dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/mainCardBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HYUNDAI"
                        android:textColor="#CCCCCC"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"/>
                    <TextView
                        android:id="@+id/mainCardNetwork"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="VISA"
                        android:textColor="#FFD700"
                        android:textSize="14sp"
                        android:textStyle="bold"/>
                </RelativeLayout>

                <View
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:background="#C8A030"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:id="@+id/mainCardNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="•••• •••• •••• ••••"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:letterSpacing="0.1"
                    android:fontFamily="monospace"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnChangeCard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#111820"
                android:text="다른 카드로 변경"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내 차량 정보"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#111820"
                android:padding="16dp"
                android:layout_marginBottom="24dp">
                <TextView
                    android:id="@+id/tvPlateNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="123가4567"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tvVinShort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIN: KMH•••"
                    android:textColor="#556677"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutParkingActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1A2535"
                android:padding="16dp"
                android:layout_marginBottom="24dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/tvActiveLotName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="주차장 이름"
                    android:textColor="#00FF88"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="주차 시간"
                        android:textColor="#AAAAAA"/>
                    <TextView
                        android:id="@+id/tvParkingTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"
                        android:textColor="#FFFFFF"
                        android:gravity="end"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="예상 요금"
                        android:textColor="#AAAAAA"/>
                    <TextView
                        android:id="@+id/tvParkingEstFee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0원"
                        android:textColor="#FFFFFF"
                        android:gravity="end"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettleNow"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="#00E87A"
                    android:text="지금 정산하기"
                    android:textColor="#000000"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="근처 제휴 주차장"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:id="@+id/layoutParkingLots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근 결제 내역"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:id="@+id/layoutTxHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>