<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A15"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tvRegStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="차량 결제 시스템 연동"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvRegDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="스마트폰 카메라로 아래 QR 코드를 스캔하여\n마이현대 로그인을 진행해 주세요."
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <ImageView
            android:id="@+id/ivQrCode"
            android:layout_width="250dp"
            android:layout_height="250dp" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progressBarReg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="16dp"
        android:indeterminateTint="#00FF88"/>

    <TextView
        android:id="@+id/tvPollingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="스마트폰 인증 대기 중..."
        android:textColor="#00FF88"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="취소"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:paddingHorizontal="32dp"/>

</LinearLayout>