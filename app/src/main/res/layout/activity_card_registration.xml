<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080C10">

    <!-- 상단 안내 -->
    <TextView
        android:id="@+id/tvCardStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:text="결제 카드를 등록해 주세요"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:gravity="center"
        android:background="#0D1520" />

    <!-- 로딩 표시 -->
    <ProgressBar
        android:id="@+id/progressBarCard"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:indeterminateTint="#00E87A"
        android:visibility="gone" />

    <!-- Mock PG 카드 입력 WebView -->
    <WebView
        android:id="@+id/webViewCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
